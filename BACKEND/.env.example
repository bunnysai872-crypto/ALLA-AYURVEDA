# ==============================================================================
# ALLA Ayurveda Backend Environment Configuration Template
# Copy this file to .env for local development or set in your cloud provider dashboard
# ==============================================================================

# Database Connection (MySQL)
# Example for cloud: mysql+pymysql://<user>:<password>@<host>:<port>/<dbname>
# Note: Render/Railway 'mysql://' URLs are automatically converted to 'mysql+pymysql://'
DATABASE_URL=mysql+pymysql://root:root@localhost/alla_ayurveda

# JWT Security
# Generate a random 64-char string: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-secure-random-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Cross-Origin Resource Sharing (CORS)
# Set to specific frontend URL in production (e.g., https://alla-ayurveda.vercel.app)
# or comma-separated URLs: https://alla-ayurveda.vercel.app,http://localhost:5173
CORS_ORIGINS=*

# Document Storage
# Directory where clinical trial documents are saved
# On Render, point to a mounted Persistent Disk (e.g., /var/data/uploads) if configured
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=16777216

# Server Port (Render sets PORT automatically)
PORT=5000
